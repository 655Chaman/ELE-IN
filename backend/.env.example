# ==============================================================================
# ELE-IN PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Governance: Three-Layer Logic Architecture (Paranoia Framework)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
ENV=production
FRONTEND_URL=https://app.ele-in.com

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Required)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 3. BILLING & MONETIZATION SECURITY (Fail-Closed Enforcement)
# ------------------------------------------------------------------------------
# In production, ALLOW_MOCK_BILLING MUST be set to "false" to prevent mock order exploitation
ALLOW_MOCK_BILLING=false

# Razorpay Production Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe Production Keys (Optional / Fallback)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# LemonSqueezy (Optional / Subscriptions)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHY & VAULT ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte hexadecimal key for AES-256-GCM BYOK token encryption
BYOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ELEIN_HMAC_SECRET=your_hmac_secret_for_webhook_signatures
COOKIE_PRIVATE_KEY=your_cookie_private_key
COOKIE_PUBLIC_KEY=your_cookie_public_key
METRICS_TOKEN=your_metrics_bearer_token

# ------------------------------------------------------------------------------
# 5. AI PROVIDER & LLM GATEWAY KEYS
# ------------------------------------------------------------------------------
# Comma-separated pool of NVIDIA Nim or OpenAI-compatible API keys
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
NVIDIA_API_KEY_SYNTHESIS=
NVIDIA_API_KEY_SCORING=
NVIDIA_API_KEY_PERSONALIZE=
NVIDIA_API_KEY_INTENT=
NVIDIA_API_KEY_DRAFTING=

# Audio / Voice Transcription
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL & OUTREACH PROVIDERS
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=outreach@ele-in.com

# ------------------------------------------------------------------------------
# 7. PROXY & ROTATION INFRASTRUCTURE
# ------------------------------------------------------------------------------
WEBSHARE_API_KEY=

# ------------------------------------------------------------------------------
# 8. INTEGRATIONS (CRM & Data Enrichment)
# ------------------------------------------------------------------------------
APOLLO_API_KEY=
HUBSPOT_ACCESS_TOKEN=
SMARTLEAD_API_KEY=
INSTANTLY_API_KEY=

# ------------------------------------------------------------------------------
# 9. RETENTION & CLEANUP SERVICE SETTINGS
# ------------------------------------------------------------------------------
NOTIFICATION_READ_RETENTION_DAYS=30
NOTIFICATION_UNREAD_RETENTION_DAYS=90
OUTBOX_DELIVERED_RETENTION_DAYS=14
OUTBOX_FAILED_RETENTION_DAYS=30
RETENTION_PRUNE_CHUNK_SIZE=500
RETENTION_MAX_CHUNKS=20
